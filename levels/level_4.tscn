[sub_resource type="Shader" id="Shader_l4_post"]
code = "shader_type canvas_item;
// Grayscale with posterized bands (cel-style), brightened so the rooms stay readable.
uniform sampler2D screen_tex : hint_screen_texture, filter_nearest;
// Below 1.0 brightens the dark parts (0.5 = strong lift, 1.0 = none).
uniform float gamma : hint_range(0.2, 1.5) = 0.6;
// 1.0 = none. A little above 1.0 deepens the darks and brightens the lights.
uniform float contrast : hint_range(0.5, 2.0) = 1.15;
// Number of gray bands (2 = pure black/white).
uniform int bands : hint_range(2, 8) = 5;
// 1.0 = hard bands, 0.0 = smooth grayscale.
uniform float hardness : hint_range(0.0, 1.0) = 0.8;
// Darkest and brightest gray that can appear.
uniform float min_tone : hint_range(0.0, 0.5) = 0.08;
uniform float max_tone : hint_range(0.5, 1.0) = 1.0;

void fragment() {
	vec3 c = texture(screen_tex, SCREEN_UV).rgb;
	float l = pow(dot(c, vec3(0.299, 0.587, 0.114)), gamma);
	l = clamp((l - 0.5) * contrast + 0.5, 0.0, 1.0);
	float n = float(bands);
	float q = min(floor(l * n), n - 1.0) / (n - 1.0);
	float v = mix(l, q, hardness);
	COLOR = vec4(vec3(mix(min_tone, max_tone, clamp(v, 0.0, 1.0))), 1.0);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_l4_post"]
shader = SubResource("Shader_l4_post")
shader_parameter/gamma = 0.6
shader_parameter/contrast = 1.15
shader_parameter/bands = 5
shader_parameter/hardness = 0.8
shader_parameter/min_tone = 0.08
shader_parameter/max_tone = 1.0

